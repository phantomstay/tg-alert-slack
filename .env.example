TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL_ID=

SLACK_WEBHOOK_URL=

# optional filters, leave blank for none
MAX_PRICE=
MIN_SEATS=

# fallback photo shown when the aircraft type has no entry in aircraft_images.json
ALERT_IMAGE_URL=

# absolute path for the dedupe db under systemd; blank uses ./state.db
STATE_DB=
# re-read the last N posts on startup so a restart does not lose alerts
CATCHUP=20

# where health failures are posted; falls back to SLACK_WEBHOOK_URL if blank
SLACK_OPS_WEBHOOK_URL=
# --health fails if the channel has posted nothing in this many hours
STALE_HOURS=48
# while still broken, do not re-notify the ops channel more often than this
NOTIFY_COOLDOWN_HOURS=12
